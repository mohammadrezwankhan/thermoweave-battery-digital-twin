{
  "schemaVersion": "thermoweave.config/v1",
  "scenario": {"id": "E6-sensor-fault", "description": "Biased zonal temperature sensor"},
  "simulation": {"duration_s": 240, "outputStep_s": 1, "solver": "ode15s", "seed": 6},
  "layout": {"type": "rectangular", "rows": 3, "columns": 4, "zoneCount": 4},
  "controller": {"mode": "baseline"},
  "boundary": {"mode": "scalar", "temperature_K": 298.15, "conductance_W_per_K": 0.25},
  "electrical": {"current_A": 10},
  "faults": {"events": [{"type": "sensor_bias", "target": 2, "start_s": 180, "end_s": 240, "magnitude": 5}]}
}

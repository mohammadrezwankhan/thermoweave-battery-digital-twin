    {
      "id": "doc-ea7fd4279c40",
      "title": "ThermoWeave portfolio case study",
      "path": "docs/portfolio-case-study.md",
      "line": 1,
      "source_paths": [
        "docs/portfolio-case-study.md"
      ],
      "source_url": "https://github.com/mohammadrezwankhan/thermoweave-battery-digital-twin/blob/e62c0d720aa92273e4b8c9a2b03977ba06045fd2/docs/portfolio-case-study.md#L1",
      "source_revision": "e62c0d720aa92273e4b8c9a2b03977ba06045fd2",
      "source_kind": "audited-native-source",
      "source_label": "Source at e62c0d720aa9",
      "catalog_url": null,
      "native_url": null,
      "excerpt": "Pack averages hide the spatial behavior that often drives thermal decisions. A single boundary temperature cannot explain inlet-to-outlet coolant warming, localized restrictions, uneven cell resistance, or a controller acting on zones. The project needed a transparent way to make those effects inspectable without requiring Simscape Battery for the core workflow.",
      "type": "Native reading",
      "section": "scope",
      "tags": [
        "model",
        "reproduction"
      ],
      "track": null,
      "lesson_id": null
    },
    {
      "id": "doc-a5940e4ecbbe",
      "title": "ThermoWeave predeclared experiment matrix (E0-E10)",
      "path": "docs/scenarios.md",
      "line": 1,
      "source_paths": [
        "docs/scenarios.md"
      ],
      "source_url": "https://github.com/mohammadrezwankhan/thermoweave-battery-digital-twin/blob/e62c0d720aa92273e4b8c9a2b03977ba06045fd2/docs/scenarios.md#L1",
      "source_revision": "e62c0d720aa92273e4b8c9a2b03977ba06045fd2",
      "source_kind": "audited-native-source",
      "source_label": "Source at e62c0d720aa9",
      "catalog_url": null,
      "native_url": null,
      "excerpt": "These IDs and settings define the synthetic demonstration suite. They are independent of the cited MathWorks example. Every run uses thermoweave.result/v1, records the resolved configuration and scenario hash, and reports normalized energy residual. Thresholds are engineering-demo assumptions, not validated battery limits.",

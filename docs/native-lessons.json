    },
    {
      "id": "doc-56f5e3896d9a",
      "title": "Verification and numerical evidence",
      "path": "docs/validation.md",
      "line": 1,
      "source_paths": [
        "docs/validation.md"
      ],
      "source_url": "https://github.com/mohammadrezwankhan/thermoweave-battery-digital-twin/blob/e62c0d720aa92273e4b8c9a2b03977ba06045fd2/docs/validation.md#L1",

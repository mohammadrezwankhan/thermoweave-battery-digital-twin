      ],
      "source_url": "https://github.com/mohammadrezwankhan/thermoweave-battery-digital-twin/blob/e62c0d720aa92273e4b8c9a2b03977ba06045fd2/docs/model.md#L1",
      "source_revision": "e62c0d720aa92273e4b8c9a2b03977ba06045fd2",
      "source_kind": "audited-native-source",
      "source_label": "Source at e62c0d720aa9",
      "catalog_url": null,
      "native_url": null,
      "excerpt": "ThermoWeave is a reproducible, reduced-order model for a synthetic battery-like assembly. Every numerical value in this document is an assumption for software experiments. It is not fitted to a named cell and must not be presented as validated real-cell accuracy.",

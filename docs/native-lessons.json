        "native-lesson",
        "scope",
        "verification"
      ],
      "track": null,
      "lesson_id": null
    },
    {
      "id": "doc-9197ef63e505",
      "title": "ThermoWeave scientific and controls specification",
      "path": "docs/model.md",
      "line": 1,
      "source_paths": [
